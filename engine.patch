+.kiroku-desktop .history-empty-title {
+  font: 300 24px/1.2 var(--t-logo);
+  letter-spacing: -0.02em;
+  color: var(--t-ink);
+}
+.kiroku-desktop .history-empty-title::before {
+  content: '(';
+  color: var(--t-aqua);
+  margin-right: 0.06em;
+}
+.kiroku-desktop .history-empty-title::after {
+  content: ')';
+  color: var(--t-aqua);
+  margin-left: 0.06em;
+}
+.kiroku-desktop .history-empty-body {
+  color: var(--t-muted);
+  font-size: 13.5px;
+}
+.kiroku-desktop .history-empty-action {
+  margin-top: 18px;
+}
+
+/* ---------- focus ---------- */
+.kiroku-desktop .history-page :focus-visible,
+.kiroku-desktop .history-rail :focus-visible {
+  outline: 2px solid var(--t-aqua);
+  outline-offset: 3px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .kiroku-desktop .history-empty-mark {
+    animation: none;
+  }
+}
+
+/* Desktop app: "Open the editor" points at the public site home; the Home tab already does this job. */
+.kiroku-desktop .history-back {
+  display: none;
+}
