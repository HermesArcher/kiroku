+  margin-left: 0.08em;
+}
+.kiroku-desktop .history-intro {
+  color: var(--t-ink-2);
+  font-size: 13.5px;
+}
+.kiroku-desktop .history-rail-label,
+.kiroku-desktop .history-usage {
+  font: 400 8px/1.4 var(--t-wide);
+  letter-spacing: 0.3em;
+  text-transform: uppercase;
+  color: var(--t-muted);
+}
+.kiroku-desktop .history-usage {
+  letter-spacing: 0.22em;
+  font-size: 7.5px;
+}
+.kiroku-desktop .history-rail-label {
+  color: var(--t-ink);
+}
+.kiroku-desktop .history-rail-block {
+  border-top: 1px dashed var(--t-line-strong);
+  padding-top: 16px;
+  gap: 12px;
+}
+.kiroku-desktop .history-rail > .history-usage + .history-rail-block {
+  border-top: 0;
+  padding-top: 0;
+}
+.kiroku-desktop .history-note {
+  color: var(--t-muted);
+  font-size: 12px;
+}
+.kiroku-desktop .history-note-warn {
+  color: var(--t-danger);
+}
+
+/* ---------- toolbar: inset frosted capsules ---------- */
+.kiroku-desktop .history-search {
+  width: 300px;
+  --ran-input-min-height: 38px;
+  --ran-input-border-radius: 999px;
+  --ran-input-padding: 0 8px 0 16px;
