+}
+.kiroku-desktop .history-kind[data-ext='xlsx'],
+.kiroku-desktop .history-kind[data-ext='xls'],
+.kiroku-desktop .history-kind[data-ext='csv'] {
+  --kc: #7dbb14;
+}
+.kiroku-desktop .history-kind[data-ext='pptx'],
+.kiroku-desktop .history-kind[data-ext='ppt'] {
