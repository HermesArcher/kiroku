+  font-weight: 600;
+  -webkit-backdrop-filter: blur(14px);
+  backdrop-filter: blur(14px);
+}
+.kiroku-desktop .history-filter:hover {
+  color: var(--t-ink);
+  border-color: var(--t-aqua-hi);
+}
+.kiroku-desktop .history-filter.is-on {
+  color: var(--t-ink-key);
