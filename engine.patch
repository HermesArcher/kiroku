+  box-shadow: none;
+  filter: drop-shadow(0 4px 8px rgba(16, 110, 124, 0.3));
+}
+
+/* ---------- tracklist: one glass panel, dotted leaders, hover = glass capsule ---------- */
+.kiroku-desktop .history-row {
+  margin: 0;
