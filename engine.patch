diff --git a/test/unit/history-backup-settings.test.ts b/test/unit/history-backup-settings.test.ts
new file mode 100644
index 0000000..088c1c2
--- /dev/null
+++ b/test/unit/history-backup-settings.test.ts
@@ -0,0 +1,152 @@
+import 'fake-indexeddb/auto';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+vi.mock('../../lib/onlyoffice/save-stream', () => ({ requestSaveDocument: vi.fn() }));
+vi.mock('../../lib/onlyoffice/readonly', () => ({ getReadonlyMode: vi.fn(() => false) }));
+
+import {
+  DAY_MS,
+  DEFAULT_BACKUP,
+  applyBackup,
+  getBackup,
+  maxAgeMs,
+  normalizeBackup,
+  onBackupChange,
+  resetBackupForTests,
+} from '../../lib/history/backup-settings';
+import { shouldSnapshot, snapshotInterval, type SnapshotDecision } from '../../lib/history/autosave';
+import { DB_NAME, resetHistoryDbForTests } from '../../lib/history/db';
+import {
+  getDoc,
+  pruneExpired,
+  putSnapshot,
+  resetHistoryClockForTests,
+} from '../../lib/history/store';
+import { daysUntilExpiry } from '../../lib/history/types';
+
+const bytes = (size: number) => new Uint8Array(size).fill(7);
+
+async function wipe(): Promise<void> {
+  resetHistoryDbForTests();
+  resetHistoryClockForTests();
+  await new Promise<void>((resolve) => {
+    const request = indexedDB.deleteDatabase(DB_NAME);
+    request.onsuccess = () => resolve();
+    request.onerror = () => resolve();
+    request.onblocked = () => resolve();
+  });
+}
+
+describe('backup settings', () => {
+  beforeEach(() => resetBackupForTests());
+
+  it('defaults match the old fixed behaviour (60 s, 3 versions, 7 days, on)', () => {
+    expect(getBackup()).toEqual({ autosave: true, intervalSec: 60, keepVersions: 3, keepDays: 7 });
+    expect(maxAgeMs()).toBe(7 * DAY_MS);
+  });
+
+  it('snaps hand-edited values to the allowed lists and ignores junk', () => {
+    expect(normalizeBackup({ intervalSec: 5, keepVersions: 4, keepDays: 100, autosave: 'no' })).toEqual({
+      autosave: true,
+      intervalSec: 30,
+      keepVersions: 3,
+      keepDays: 30,
+    });
+    expect(normalizeBackup({ intervalSec: 999, keepVersions: 99, keepDays: 0 })).toMatchObject({
+      intervalSec: 180,
+      keepVersions: 10,
+      keepDays: 1,
+    });
+    expect(normalizeBackup(null)).toEqual(DEFAULT_BACKUP);
+    expect(normalizeBackup({ intervalSec: 'x' })).toEqual(DEFAULT_BACKUP);
+    // a partial patch keeps the other fields of the base
+    expect(normalizeBackup({ keepDays: 30 }, { ...DEFAULT_BACKUP, intervalSec: 120 })).toMatchObject({
+      intervalSec: 120,
+      keepDays: 30,
+    });
+  });
+
+  it('applyBackup merges a patch and notifies subscribers', () => {
+    const seen: number[] = [];
+    const off = onBackupChange((s) => seen.push(s.intervalSec));
+    applyBackup({ intervalSec: 120 });
+    applyBackup({ keepDays: 30 });
+    off();
+    applyBackup({ intervalSec: 30 });
+    expect(seen).toEqual([120, 120]);
+    expect(getBackup()).toMatchObject({ intervalSec: 30, keepDays: 30 });
+  });
+});
+
+describe('autosave interval follows the setting', () => {
+  beforeEach(() => resetBackupForTests());
+
+  it.each([30, 60, 120, 180])('a fast export earns exactly the chosen %i s', (sec) => {
+    applyBackup({ intervalSec: sec });
+    expect(snapshotInterval(null)).toBe(sec * 1000);
+    expect(snapshotInterval(40)).toBe(sec * 1000);
+  });
+
+  it('a slow export still backs off past a short choice', () => {
+    applyBackup({ intervalSec: 30 });
+    expect(snapshotInterval(400)).toBe(120_000);
+    expect(snapshotInterval(5_000)).toBe(180_000);
+  });
+
+  it('shouldSnapshot waits for the chosen interval', () => {
+    const state: SnapshotDecision = {
+      now: 1_000_000,
+      enabled: true,
+      dirty: true,
+      readonly: false,
+      holdsLock: true,
+      lastSnapshotAt: 1_000_000 - 35_000,
+      lastEditAt: 0,
+      exporting: false,
+      lastExportMs: null,
+    };
+    applyBackup({ intervalSec: 30 });
+    expect(shouldSnapshot(state)).toBe(true);
+    applyBackup({ intervalSec: 60 });
+    expect(shouldSnapshot(state)).toBe(false);
+  });
+});
+
+describe('retention follows the settings', () => {
+  beforeEach(async () => {
+    resetBackupForTests();
+    await wipe();
+  });
+  afterEach(() => vi.restoreAllMocks());
+
+  it('keeps 5 versions when asked, 10 when asked, and trims older ones', async () => {
+    for (const keep of [3, 5, 10]) {
+      applyBackup({ keepVersions: keep });
+      let id: string | undefined;
+      for (let i = 0; i < 12; i += 1) id = (await putSnapshot({ id, title: `K${keep}.docx`, origin: 'local', bytes: bytes(10) }))!.id;
+      expect((await getDoc(id!))?.revCount).toBe(keep);
+    }
+  });
+
+  it('keep-for decides when a document expires', async () => {
+    const doc = (await putSnapshot({ title: 'Old.docx', origin: 'local', bytes: bytes(10) }))!;
+    const later = Date.now() + 10 * DAY_MS;
+    vi.spyOn(Date, 'now').mockReturnValue(later);
+
+    applyBackup({ keepDays: 30 });
+    expect(daysUntilExpiry(doc, later)).toBe(20);
+    expect(await pruneExpired()).toEqual([]);
+    expect(await getDoc(doc.id)).not.toBeNull();
+
+    applyBackup({ keepDays: 7 });
+    expect(await pruneExpired()).toEqual([doc.id]);
+    expect(await getDoc(doc.id)).toBeNull();
+  });
+
+  it('a 1-day window drops yesterday\'s document', async () => {
+    const doc = (await putSnapshot({ title: 'Yesterday.docx', origin: 'local', bytes: bytes(10) }))!;
+    vi.spyOn(Date, 'now').mockReturnValue(Date.now() + 2 * DAY_MS);
+    applyBackup({ keepDays: 1 });
+    expect(await pruneExpired()).toEqual([doc.id]);
+  });
+});
diff --git a/test/unit/kiroku.test.ts b/test/unit/kiroku.test.ts
new file mode 100644
index 0000000..b74644e
--- /dev/null
+++ b/test/unit/kiroku.test.ts
@@ -0,0 +1,134 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+const { mockOnCreateNew, mockOpenLocalFile, mockRequestSaveDocument, mockSetDiskWriter } = vi.hoisted(() => ({
+  mockOnCreateNew: vi.fn().mockResolvedValue(undefined),
+  mockOpenLocalFile: vi.fn().mockResolvedValue(undefined),
+  mockRequestSaveDocument: vi.fn(),
+  mockSetDiskWriter: vi.fn(),
+}));
+
+vi.mock('../../lib/document', () => ({ onCreateNew: mockOnCreateNew, openLocalFile: mockOpenLocalFile }));
+vi.mock('../../lib/onlyoffice/save-stream', () => ({
+  requestSaveDocument: mockRequestSaveDocument,
+  setDiskWriter: mockSetDiskWriter,
+}));
+
+import { bootKiroku, installKirokuBridge, type KirokuBridge } from '../../lib/kiroku';
+import { isKirokuMode } from '../../lib/embed-mode';
+import { markDocumentDirty, markDocumentSaved, resetUnsavedGuardForTests } from '../../lib/unsaved-guard';
+import { setDocmentObj } from '@ranuts/shared/store';
+
+function installBridge(overrides: Partial<KirokuBridge> = {}): KirokuBridge {
+  const bridge: KirokuBridge = {
+    boot: vi.fn().mockResolvedValue({ kind: 'none' }),
+    save: vi.fn().mockResolvedValue('written'),
+    setDirty: vi.fn(),
+    ...overrides,
+  };
+  window.kiroku = bridge;
+  return bridge;
+}
+
+describe('kiroku bridge', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  afterEach(() => {
+    delete window.kiroku;
+    delete window.__kirokuSave;
+    resetUnsavedGuardForTests();
+  });
+
+  it('is off without window.kiroku and on with it', () => {
+    expect(isKirokuMode()).toBe(false);
+    installBridge();
+    expect(isKirokuMode()).toBe(true);
+  });
+
+  describe('boot', () => {
+    it('creates a blank document for kind "new"', async () => {
+      installBridge({ boot: vi.fn().mockResolvedValue({ kind: 'new', ext: 'xlsx' }) });
+      await expect(bootKiroku()).resolves.toBe(true);
+      expect(mockOnCreateNew).toHaveBeenCalledWith('.xlsx');
+      expect(mockOpenLocalFile).not.toHaveBeenCalled();
+    });
+
+    it('opens the bytes for kind "open"', async () => {
+      installBridge({
+        boot: vi.fn().mockResolvedValue({ kind: 'open', name: 'a.docx', bytes: new Uint8Array([1, 2, 3]) }),
+      });
+      await expect(bootKiroku()).resolves.toBe(true);
+      const file = mockOpenLocalFile.mock.calls[0][0] as File;
+      expect(file.name).toBe('a.docx');
+      expect(file.size).toBe(3);
+      expect(mockOnCreateNew).not.toHaveBeenCalled();
+    });
+
+    it('opens nothing for kind "none" so the URL logic can run', async () => {
+      installBridge();
+      await expect(bootKiroku()).resolves.toBe(false);
+      expect(mockOnCreateNew).not.toHaveBeenCalled();
+      expect(mockOpenLocalFile).not.toHaveBeenCalled();
+    });
+  });
+
+  describe('disk writer', () => {
+    async function writer(bridge: KirokuBridge) {
+      window.kiroku = bridge;
+      installKirokuBridge();
+      return mockSetDiskWriter.mock.calls[0][0] as (file: File) => Promise<string>;
+    }
+
+    it('passes the name and a Uint8Array and returns the outcome', async () => {
+      const bridge = installBridge();
+      const write = await writer(bridge);
+      await expect(write(new File([new Uint8Array([7, 8])], 'doc.docx'))).resolves.toBe('written');
+      const [name, bytes] = (bridge.save as ReturnType<typeof vi.fn>).mock.calls[0];
+      expect(name).toBe('doc.docx');
+      expect(bytes).toBeInstanceOf(Uint8Array);
+      expect(Array.from(bytes as Uint8Array)).toEqual([7, 8]);
+    });
+
+    it('maps "unavailable" to "cancelled" so no anchor download follows', async () => {
+      const write = await writer(installBridge({ save: vi.fn().mockResolvedValue('unavailable') }));
+      await expect(write(new File(['x'], 'doc.docx'))).resolves.toBe('cancelled');
+    });
+
+    it('keeps "cancelled" as is', async () => {
+      const write = await writer(installBridge({ save: vi.fn().mockResolvedValue('cancelled') }));
+      await expect(write(new File(['x'], 'doc.docx'))).resolves.toBe('cancelled');
+    });
+  });
+
+  it('forwards every dirty flip to setDirty', () => {
+    const bridge = installBridge();
+    installKirokuBridge();
+    markDocumentDirty();
+    markDocumentSaved();
+    expect(bridge.setDirty).toHaveBeenNthCalledWith(1, true);
+    expect(bridge.setDirty).toHaveBeenNthCalledWith(2, false);
+  });
+
+  describe('__kirokuSave', () => {
+    it('exports in the own format (legacy -> OOXML sibling)', async () => {
+      const bridge = installBridge();
+      installKirokuBridge();
+      setDocmentObj({ fileName: 'old.doc' });
+      mockRequestSaveDocument.mockResolvedValue(new File(['z'], 'old.docx'));
+      await expect(window.__kirokuSave!()).resolves.toBe('written');
+      expect(mockRequestSaveDocument).toHaveBeenCalledWith('DOCX');
+      expect((bridge.save as ReturnType<typeof vi.fn>).mock.calls[0][0]).toBe('old.docx');
+    });
+
+    it('passes "unavailable" through and reports "failed" on exceptions', async () => {
+      installBridge({ save: vi.fn().mockResolvedValue('unavailable') });
+      installKirokuBridge();
+      setDocmentObj({ fileName: 'a.xlsx' });
+      mockRequestSaveDocument.mockResolvedValue(new File(['z'], 'a.xlsx'));
+      await expect(window.__kirokuSave!()).resolves.toBe('unavailable');
+      mockRequestSaveDocument.mockRejectedValue(new Error('No document is open'));
+      await expect(window.__kirokuSave!()).resolves.toBe('failed');
+    });
+  });
+});
