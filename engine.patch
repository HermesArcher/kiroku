index 0000000..675f03f
--- /dev/null
+++ b/lib/password.ts
@@ -0,0 +1,160 @@
+/**
+ * Password-protected OOXML (ECMA-376 agile encryption) for the desktop shell.
+ *
+ * x2t carries the cipher (`m_sPassword` decrypts on read, `m_sSavePassword`
+ * encrypts on write), so nothing here implements crypto. This module only:
+ *  - spots an encrypted container (an OLE file holding an `EncryptedPackage`
+ *    stream, which a .docx/.xlsx/.pptx normally never is),
+ *  - asks for the password and decrypts through the x2t worker before the
+ *    editor ever sees the file,
+ *  - remembers the password for this document so every later save re-encrypts.
+ *
+ * The password lives in this page's memory only: never stored, never logged.
+ */
+
+const OLE_MAGIC = [0xd0, 0xcf, 0x11, 0xe0, 0xa1, 0xb1, 0x1a, 0xe1];
+const OOXML_EXTS = ['docx', 'docm', 'dotx', 'xlsx', 'xlsm', 'xltx', 'pptx', 'pptm', 'potx'];
+const WORKER_URL = '/sdkjs/common/wasm/x2t/x2t.worker.js';
+
+let documentPassword = '';
+
+export function getDocumentPassword(): string {
+  return documentPassword;
+}
+
+export function setDocumentPassword(password: string): void {
+  documentPassword = password || '';
+}
+
+/** Targets x2t can encrypt with an ECMA-376 password. */
+export function canEncryptTarget(ext: string): boolean {
+  return OOXML_EXTS.includes(ext.replace(/^\./, '').toLowerCase());
+}
+
+function includesUtf16(bytes: Uint8Array, text: string): boolean {
+  const first = text.charCodeAt(0);
+  for (let at = bytes.indexOf(first); at !== -1; at = bytes.indexOf(first, at + 1)) {
+    let ok = bytes[at + 1] === 0;
+    for (let i = 1; i < text.length && ok; i += 1) {
+      ok = bytes[at + i * 2] === text.charCodeAt(i) && bytes[at + i * 2 + 1] === 0;
+    }
+    if (ok) return true;
+  }
+  return false;
+}
+
+/** An OOXML file name whose bytes are an encrypted OLE container instead of a ZIP. */
+export function isEncryptedOoxml(bytes: Uint8Array, name: string): boolean {
+  const ext = name.split('.').pop()?.toLowerCase() ?? '';
+  if (!OOXML_EXTS.includes(ext) || bytes.length < 512) return false;
+  if (OLE_MAGIC.some((byte, i) => bytes[i] !== byte)) return false;
+  return includesUtf16(bytes, 'EncryptedPackage');
+}
+
+type WorkerReply = { id?: number; ok?: boolean; result?: { binary?: Uint8Array }; error?: string };
+
+/**
+ * Add (`savePassword`) or remove (`password`, no `savePassword`) protection.
+ * Runs in a throwaway worker so x2t's heap goes back to the browser afterwards.
+ */
+export function recryptOoxml(
+  bytes: Uint8Array,
+  name: string,
+  passwords: { password?: string; savePassword?: string },
+): Promise<Uint8Array> {
+  const ext = name.split('.').pop()?.toLowerCase() ?? 'docx';
+  const base = name.replace(/\.[^.]*$/, '') || 'document';
+  return new Promise((resolve, reject) => {
+    const worker = new Worker(WORKER_URL);
+    const done = (fn: () => void): void => {
+      worker.terminate();
+      fn();
+    };
+    worker.onmessage = (event: MessageEvent<WorkerReply>) => {
+      if (event.data?.id !== 1) return; // the worker's ready ping
+      if (event.data.ok && event.data.result?.binary) {
+        const out = event.data.result.binary;
+        done(() => resolve(new Uint8Array(out)));
+      } else done(() => reject(new Error(event.data.error || 'Conversion failed')));
+    };
+    worker.onerror = (event) => done(() => reject(new Error(event.message || 'x2t worker failed')));
+    worker.postMessage({ id: 1, op: 'recrypt', payload: { data: bytes, fileName: base, ext, passwords }, fonts: [] });
+  });
+}
+
+/** Small modal asking for a password. Resolves null on cancel. */
+export function askPassword(fileName: string, wrong: boolean): Promise<string | null> {
+  return new Promise((resolve) => {
+    const mask = document.createElement('div');
+    mask.id = 'kiroku-password-dialog';
+    mask.setAttribute('role', 'dialog');
+    mask.setAttribute('aria-modal', 'true');
+    mask.style.cssText =
+      'position:fixed;inset:0;z-index:2147483000;display:flex;align-items:center;justify-content:center;background:rgba(4,16,18,.55);font:14px/1.4 system-ui,sans-serif';
+    const card = document.createElement('form');
+    card.style.cssText =
+      'min-width:340px;max-width:440px;padding:22px;border-radius:14px;background:var(--ran-color-bg,#f4fbfb);color:var(--ran-color-text,#0f3a46);box-shadow:0 18px 60px rgba(0,0,0,.35)';
+    const title = document.createElement('div');
+    title.textContent = 'This document is password protected';
+    title.style.cssText = 'font-weight:700;font-size:16px;margin-bottom:6px';
+    const sub = document.createElement('div');
+    sub.textContent = wrong ? 'That password is not right. Try again.' : `Enter the password to open ${fileName}.`;
+    sub.style.cssText = `margin-bottom:12px;${wrong ? 'color:#b3261e' : 'opacity:.8'}`;
+    const input = document.createElement('input');
+    input.type = 'password';
+    input.id = 'kiroku-password-input';
+    input.autocomplete = 'off';
+    input.style.cssText =
+      'width:100%;box-sizing:border-box;padding:9px 11px;border-radius:8px;border:1px solid #8aa;font:inherit';
+    const row = document.createElement('div');
+    row.style.cssText = 'display:flex;gap:8px;justify-content:flex-end;margin-top:16px';
+    const cancel = document.createElement('button');
+    cancel.type = 'button';
+    cancel.id = 'kiroku-password-cancel';
+    cancel.textContent = 'Cancel';
+    const ok = document.createElement('button');
+    ok.type = 'submit';
+    ok.id = 'kiroku-password-ok';
+    ok.textContent = 'Open';
+    for (const b of [cancel, ok])
+      b.style.cssText = 'padding:8px 16px;border-radius:8px;border:1px solid #8aa;font:inherit;cursor:pointer';
+    row.append(cancel, ok);
+    card.append(title, sub, input, row);
+    mask.append(card);
+    const finish = (value: string | null): void => {
+      mask.remove();
+      resolve(value);
+    };
+    card.addEventListener('submit', (e) => {
+      e.preventDefault();
+      if (input.value) finish(input.value);
+    });
+    cancel.addEventListener('click', () => finish(null));
+    mask.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape') finish(null);
+    });
+    document.body.append(mask);
+    input.focus();
+  });
+}
+
+/**
+ * Decrypt a protected file, asking until the password works or the user gives up.
+ * Returns the plain OOXML bytes and the password to keep protecting saves with.
+ */
+export async function unlockOoxml(
+  bytes: Uint8Array,
+  name: string,
+  ask: (fileName: string, wrong: boolean) => Promise<string | null> = askPassword,
+): Promise<{ bytes: Uint8Array; password: string } | null> {
+  let wrong = false;
+  for (;;) {
+    const password = await ask(name, wrong);
+    if (password === null) return null;
+    try {
+      return { bytes: await recryptOoxml(bytes, name, { password }), password };
+    } catch {
+      wrong = true;
+    }
+  }
+}
