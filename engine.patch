+}
+.kiroku-desktop .history-row:hover {
+  background: linear-gradient(180deg, var(--t-glass-hi), var(--t-glass-2));
+  box-shadow:
+    inset 0 0 0 1px var(--t-edge),
+    0 6px 16px -10px var(--t-glow);
+  border-bottom-color: transparent;
+}
+.kiroku-desktop .history-kind {
+  --kc: var(--t-aqua);
+  width: 54px;
+  padding: 6px 0;
+  border: 1px solid var(--t-edge);
