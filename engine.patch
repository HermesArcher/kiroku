new file mode 100644
index 0000000..48883dd
--- /dev/null
+++ b/lib/kiroku.ts
@@ -0,0 +1,116 @@
+/**
+ * Kiroku desktop bridge. The Electron preload exposes `window.kiroku`
+ * (contextBridge) before any page script runs; its presence is the whole
+ * "desktop mode" switch. Everything Kiroku-specific lives in this module, the
+ * rest of the app only calls the hooks below.
+ */
+import { getDocmentObj } from '@ranuts/shared/store';
+import { bytesToBase64 } from 'ranuts/utils';
+import { onCreateNew, openLocalFile } from './document';
+import { requestSaveDocument, setDiskWriter } from './onlyoffice/save-stream';
+import { captureSavePoint, commitSavePoint } from './onlyoffice/save-point';
+import { markDocumentSaved, onUnsavedChangesChange } from './unsaved-guard';
+import type { SaveOutcome } from './save-target';
+import { applyBackup, followShellBackup, type BackupSettings } from './history/backup-settings';
+import { isEncryptedOoxml, setDocumentPassword, unlockOoxml } from './password';
+
+export type KirokuSaveOutcome = 'written' | 'cancelled' | 'unavailable';
+
+export interface KirokuBridge {
+  boot(): Promise<
+    | { kind: 'new'; ext: 'docx' | 'xlsx' | 'pptx'; backup?: BackupSettings }
+    | { kind: 'open'; name: string; bytes: Uint8Array; backup?: BackupSettings }
+    | { kind: 'none'; backup?: BackupSettings }
+  >;
+  save(name: string, bytes: Uint8Array): Promise<KirokuSaveOutcome>;
+  setDirty(dirty: boolean): void;
+  /** Shell Settings > Backups. Optional so an older shell still works. */
+  getBackup?(): Promise<BackupSettings>;
+  setBackup?(patch: Partial<BackupSettings>): Promise<BackupSettings>;
+  onBackup?(cb: (settings: BackupSettings) => void): void;
+  /** Close this tab (the user declined the password prompt). */
+  abandon?(): void;
+}
+
+declare global {
+  interface Window {
+    kiroku?: KirokuBridge;
+    __kirokuSave?: () => Promise<KirokuSaveOutcome | 'failed'>;
+    __kirokuExport?: (ext: string) => Promise<{ name: string; base64: string } | null>;
+  }
+}
+
+/** Wire the save path, dirty flag and close-prompt save hook to the desktop shell. */
+export function installKirokuBridge(): void {
+  const bridge = window.kiroku;
+  if (!bridge) return;
+
+  // The main process already reported a failed write, so 'unavailable' must
+  // not fall back to a browser-style anchor download in the desktop app.
+  const saveFile = async (file: File): Promise<KirokuSaveOutcome> =>
+    bridge.save(file.name, new Uint8Array(await file.arrayBuffer()));
+  setDiskWriter(async (file): Promise<SaveOutcome> => {
+    const outcome = await saveFile(file);
+    return outcome === 'unavailable' ? 'cancelled' : outcome;
+  });
+
+  onUnsavedChangesChange((dirty) => bridge.setDirty(dirty));
+  followShellBackup();
+
+  // Save As picked another format in the native dialog: export the live document in it and hand the bytes back to main.
+  window.__kirokuExport = async (ext) => {
+    try {
+      const file = await requestSaveDocument(String(ext).toUpperCase());
+      return { name: file.name, base64: bytesToBase64(new Uint8Array(await file.arrayBuffer())) };
+    } catch {
+      return null;
+    }
+  };
+
+  window.__kirokuSave = async () => {
+    try {
+      // Same target rule as embed-api's document:save: own format, legacy -> OOXML sibling.
+      const ext = (getDocmentObj()?.fileName || '').split('.').pop()?.toUpperCase() || '';
+      const target = ({ XLS: 'XLSX', DOC: 'DOCX', PPT: 'PPTX' } as Record<string, string>)[ext] || ext || 'DOCX';
+      const point = captureSavePoint();
+      const outcome = await saveFile(await requestSaveDocument(target));
+      if (outcome === 'written' && commitSavePoint(point)) markDocumentSaved();
+      return outcome;
+    } catch {
+      return 'failed';
+    }
+  };
+}
+
+/**
+ * Ask the shell what this tab should show. Returns true when it opened
+ * something; false means "nothing pending" and the normal URL logic applies.
+ */
+export async function bootKiroku(): Promise<boolean> {
+  const plan = await window.kiroku!.boot();
+  // Backup settings ride on the boot plan so they are in place before the first autosave session.
+  if (plan.backup) applyBackup(plan.backup);
+  if (plan.kind === 'new') {
+    await onCreateNew(`.${plan.ext}`);
+    return true;
+  }
+  if (plan.kind === 'open') {
+    setDocumentPassword('');
+    let bytes = plan.bytes;
+    let password = '';
+    if (isEncryptedOoxml(bytes, plan.name)) {
+      // A protected file: ask, decrypt with x2t, then open the plain copy and keep the password for saves.
+      const unlocked = await unlockOoxml(bytes, plan.name);
+      if (!unlocked) {
+        window.kiroku!.abandon?.();
+        return true;
+      }
+      bytes = unlocked.bytes;
+      password = unlocked.password;
+    }
+    await openLocalFile(new File([bytes as BlobPart], plan.name));
+    if (password) setDocumentPassword(password);
+    return true;
+  }
+  return false;
+}
