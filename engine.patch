@@ -0,0 +1,34 @@
+/**
+ * Guard 19: File > Protect > Add password works with no document server.
+ *
+ * The editor's dialog ends in `api.asc_setCurrentPassword(pwd)`, which saves
+ * and then sends a `setpassword` command to a Document Server we do not have.
+ * Offline, that command goes nowhere and the Protect panel never learns the
+ * password was set. This replaces the method with what the desktop build needs:
+ * remember the password for the page (lib/password.ts, which the x2t proxy reads
+ * on every OOXML export) and mark the document unsaved, so the next Ctrl+S
+ * writes an encrypted file. Removing the password is `asc_resetPassword()`,
+ * which calls the same method with an empty string.
+ */
+import { markDocumentDirty } from '../../unsaved-guard';
+import { getDocumentPassword, setDocumentPassword } from '../../password';
+
+type PasswordEditor = {
+  asc_setCurrentPassword?: (password: string, skipSave?: boolean) => void;
+  sendEvent?: (name: string, ...args: unknown[]) => void;
+  __kirokuPasswordGuard?: boolean;
+};
+
+export function installPasswordGuard(win: Window): boolean {
+  const editor = (win as unknown as { Asc?: { editor?: PasswordEditor } }).Asc?.editor;
+  if (!editor || typeof editor.asc_setCurrentPassword !== 'function') return false;
+  if (editor.__kirokuPasswordGuard) return true;
+  editor.asc_setCurrentPassword = (password: string) => {
+    const changed = (password || '') !== getDocumentPassword();
+    setDocumentPassword(password || '');
+    editor.sendEvent?.('asc_onDocumentPassword', Boolean(password));
+    if (changed) markDocumentDirty();
+  };
+  editor.__kirokuPasswordGuard = true;
+  return true;
+}
