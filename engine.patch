+import { describe, expect, it, vi } from 'vitest';
+import { canEncryptTarget, getDocumentPassword, isEncryptedOoxml, setDocumentPassword } from '../../lib/password';
+
+const OLE = [0xd0, 0xcf, 0x11, 0xe0, 0xa1, 0xb1, 0x1a, 0xe1];
+
+function container(...names: string[]): Uint8Array {
+  const out = new Uint8Array(4096);
+  out.set(OLE, 0);
+  let at = 600;
+  for (const name of names) {
+    for (const ch of name) {
+      out[at] = ch.charCodeAt(0);
+      out[at + 1] = 0;
+      at += 2;
+    }
+    at += 8;
+  }
+  return out;
+}
+
+describe('password-protected OOXML detection', () => {
+  it('recognises an OLE container holding an EncryptedPackage stream', () => {
+    expect(isEncryptedOoxml(container('EncryptionInfo', 'EncryptedPackage'), 'a.docx')).toBe(true);
+    expect(isEncryptedOoxml(container('EncryptedPackage'), 'sheet.XLSX')).toBe(true);
+  });
+
+  it('leaves zips, legacy OLE documents and other extensions alone', () => {
+    const zip = new Uint8Array(4096);
+    zip.set([0x50, 0x4b, 0x03, 0x04], 0);
+    expect(isEncryptedOoxml(zip, 'a.docx')).toBe(false);
+    expect(isEncryptedOoxml(container('WordDocument'), 'old.docx')).toBe(false); // legacy .doc renamed: no EncryptedPackage
+    expect(isEncryptedOoxml(container('EncryptedPackage'), 'a.odt')).toBe(false);
+    expect(isEncryptedOoxml(new Uint8Array(10), 'a.docx')).toBe(false);
+  });
+
+  it('only OOXML targets are written encrypted', () => {
+    for (const ext of ['docx', 'xlsx', 'pptx', 'docm', '.xlsm', 'POTX']) expect(canEncryptTarget(ext)).toBe(true);
+    for (const ext of ['pdf', 'odt', 'txt', 'csv', 'rtf']) expect(canEncryptTarget(ext)).toBe(false);
+  });
+
+  it('keeps the document password in memory only', () => {
+    setDocumentPassword('x');
+    expect(getDocumentPassword()).toBe('x');
+    setDocumentPassword('');
+    expect(getDocumentPassword()).toBe('');
+    expect(localStorage.length).toBe(0);
+  });
+});
+
+describe('unlockOoxml', () => {
+  it('asks again after a wrong password and gives up on cancel', async () => {
+    const { unlockOoxml } = await import('../../lib/password');
+    const ask = vi.fn().mockResolvedValueOnce('bad').mockResolvedValueOnce(null);
+    class W {
+      onmessage: ((e: unknown) => void) | null = null;
+      onerror: ((e: unknown) => void) | null = null;
+      postMessage(): void {
+        queueMicrotask(() => this.onmessage?.({ data: { id: 1, ok: false, error: 'Conversion failed with code: 91' } }));
+      }
+      terminate(): void {}
+    }
+    vi.stubGlobal('Worker', W);
+    const result = await unlockOoxml(container('EncryptedPackage'), 'a.docx', ask);
+    expect(result).toBeNull();
+    expect(ask).toHaveBeenNthCalledWith(1, 'a.docx', false);
+    expect(ask).toHaveBeenNthCalledWith(2, 'a.docx', true); // second prompt says the password was wrong
+    vi.unstubAllGlobals();
+  });
+});
