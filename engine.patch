diff --git a/lib/history/backup-settings.ts b/lib/history/backup-settings.ts
new file mode 100644
index 0000000..eb5f183
--- /dev/null
+++ b/lib/history/backup-settings.ts
@@ -0,0 +1,113 @@
+/**
+ * User-tunable backup (autosave) settings, set from the Kiroku shell's Settings
+ * page and handed to every editor page through `window.kiroku`.
+ *
+ * Kept free of imports on purpose: types.ts, store.ts and autosave.ts all read
+ * it, and a settings module that imported any of them would be a cycle.
+ *
+ * Choices are closed lists, not free numbers. The shell offers exactly these,
+ * and anything else (hand-edited settings.json, an old shell) snaps to the
+ * nearest allowed value instead of being trusted: a 0-second interval or a
+ * 0-day retention would otherwise be a way to hammer x2t or wipe the library.
+ */
+export const BACKUP_INTERVALS_SEC = [30, 60, 120, 180] as const;
+export const BACKUP_KEEP_VERSIONS = [3, 5, 10] as const;
+export const BACKUP_KEEP_DAYS = [1, 7, 30] as const;
+
+export interface BackupSettings {
+  /** Master switch. Off means no recovery snapshots at all. */
+  autosave: boolean;
+  /** Target time between snapshots, seconds. */
+  intervalSec: number;
+  /** Snapshots kept per document (the newest plus this many minus one behind it). */
+  keepVersions: number;
+  /** Days a document stays in the library after it was last edited or opened. */
+  keepDays: number;
+}
+
+export const DEFAULT_BACKUP: Readonly<BackupSettings> = Object.freeze({
+  autosave: true,
+  intervalSec: 60,
+  keepVersions: 3,
+  keepDays: 7,
+});
+
+export const DAY_MS = 24 * 60 * 60 * 1000;
+
+function snap(value: unknown, allowed: readonly number[], fallback: number): number {
+  const n = Number(value);
+  if (!Number.isFinite(n)) return fallback;
+  return allowed.reduce((best, a) => (Math.abs(a - n) < Math.abs(best - n) ? a : best), allowed[0]);
+}
+
+/** Make any input a valid settings object; missing fields come from `base`. */
+export function normalizeBackup(raw: unknown, base: Readonly<BackupSettings> = DEFAULT_BACKUP): BackupSettings {
+  const r = (raw && typeof raw === 'object' ? raw : {}) as Record<string, unknown>;
+  return {
+    autosave: typeof r.autosave === 'boolean' ? r.autosave : base.autosave,
+    intervalSec: snap(r.intervalSec, BACKUP_INTERVALS_SEC, base.intervalSec),
+    keepVersions: snap(r.keepVersions, BACKUP_KEEP_VERSIONS, base.keepVersions),
+    keepDays: snap(r.keepDays, BACKUP_KEEP_DAYS, base.keepDays),
+  };
+}
+
+let current: BackupSettings = { ...DEFAULT_BACKUP };
+const listeners = new Set<(settings: BackupSettings) => void>();
+
+export function getBackup(): BackupSettings {
+  return current;
+}
+
+export function maxAgeMs(): number {
+  return current.keepDays * DAY_MS;
+}
+
+/** Replace the settings and tell subscribers. Safe to call with the same values. */
+export function applyBackup(raw: unknown): BackupSettings {
+  current = normalizeBackup(raw, current);
+  for (const listener of listeners) listener(current);
+  return current;
+}
+
+export function onBackupChange(listener: (settings: BackupSettings) => void): () => void {
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
+/** Test seam: back to defaults without notifying. */
+export function resetBackupForTests(): void {
+  current = { ...DEFAULT_BACKUP };
+}
+
+type ShellBackup = {
+  getBackup?: () => Promise<unknown>;
+  setBackup?: (patch: Partial<BackupSettings>) => Promise<unknown>;
+  onBackup?: (cb: (settings: unknown) => void) => void;
+};
+
+function shellBackup(): ShellBackup | null {
+  return typeof window === 'undefined' ? null : ((window as unknown as { kiroku?: ShellBackup }).kiroku ?? null);
+}
+
+/** Desktop only: pull the shell's current settings. Resolves quietly without a shell. */
+export async function loadBackupFromShell(): Promise<void> {
+  const shell = shellBackup();
+  if (!shell?.getBackup) return;
+  try {
+    applyBackup(await shell.getBackup());
+  } catch {
+    // Keep defaults: backup settings are never worth blocking the editor on.
+  }
+}
+
+/** Desktop only: follow later changes made on the shell's Settings page. */
+export function followShellBackup(): void {
+  shellBackup()?.onBackup?.((settings) => applyBackup(settings));
+}
+
+/** Desktop only: write a change back to the shell (the /history autosave switch). */
+export function pushBackupToShell(patch: Partial<BackupSettings>): void {
+  void shellBackup()
+    ?.setBackup?.(patch)
+    ?.catch(() => undefined);
+}
