+/* /history inside the Kiroku desktop shell: the "Aqua-Gen" (Gen X Soft Club) look.
+ *
+ * Everything here is scoped to `html.kiroku-desktop`, which history.html sets before first paint when the
+ * Electron preload exposed `window.kiroku`. The public site never gets that class, so it is untouched.
+ * Recipe copied from the shell (app/renderer/styles.css): blurred photo world + bloom + 28px grid, frosted
+ * glass panels (r22), clear-plastic key buttons (9-slice capsule.png), inset frosted capsules, aqua gel switch,
+ * spinning iridescent CD for the empty state. Day follows the OS/app through prefers-color-scheme.
+ */
+@import './kiroku-fonts.css';
+
+html.kiroku-desktop {
+  color-scheme: light dark !important; /* theme-presentation.js may set an inline scheme from a stale site-theme choice */
+  --t-bg: #dcefee;
+  --t-glass: rgba(255, 255, 255, 0.5);
+  --t-glass-2: rgba(255, 255, 255, 0.7);
+  --t-glass-hi: rgba(255, 255, 255, 0.92);
+  --t-edge: rgba(255, 255, 255, 0.86);
+  --t-edge-dim: rgba(15, 58, 70, 0.1);
+  --t-gloss: rgba(255, 255, 255, 0.55);
+  --t-line: rgba(15, 58, 70, 0.1);
+  --t-line-strong: rgba(15, 58, 70, 0.22);
+  --t-grid: rgba(15, 58, 70, 0.045);
+  --t-ink: #0f3a46;
+  --t-ink-2: #2a5967;
+  --t-muted: #44707b;
+  --t-faint: #7fa4ac;
+  --t-aqua: #22afc4;
+  --t-aqua-hi: #6ee3ee;
+  --t-aqua-deep: #157f92;
+  --t-glow: rgba(34, 175, 196, 0.45);
+  --t-lime: #b9e53a;
+  --t-danger: #c8401f;
+  --t-ink-key: #0a4a58;
+  --t-lift: 0 22px 40px -24px rgba(16, 92, 104, 0.45);
+  --t-inset: inset 0 1px 3px rgba(16, 70, 82, 0.18);
+  --t-world: url('/kiroku/bg-day.jpg');
+  --t-world-o: 0.62;
+  --t-bloom: rgba(255, 255, 255, 0.8);
+  --t-disc-shadow: rgba(16, 92, 104, 0.35);
+  --t-font: 'Quicksand', 'Segoe UI Variable', 'Segoe UI', system-ui, sans-serif;
+  --t-logo: 'Comfortaa', 'Quicksand', sans-serif;
+  --t-wide: 'Lexend Zetta', 'Segoe UI', sans-serif;
+  /* The ranui components (inputs, buttons, the delete dialog) read these. */
+  --ran-font-family: var(--t-font);
+  --ran-color-text: var(--t-ink);
+  --ran-color-text-secondary: var(--t-muted);
+  --ran-color-text-disabled: var(--t-faint);
+  --ran-color-border: var(--t-line);
+  --ran-color-border-hover: var(--t-line-strong);
+  --ran-color-link: var(--t-aqua-deep);
+  --ran-color-warning: var(--t-danger);
+  --app-danger-fill: var(--t-danger);
+}
+@media (prefers-color-scheme: dark) {
+  html.kiroku-desktop {
+    --t-bg: #061416;
+    --t-glass: rgba(120, 225, 232, 0.06);
+    --t-glass-2: rgba(120, 225, 232, 0.11);
+    --t-glass-hi: rgba(160, 240, 245, 0.17);
+    --t-edge: rgba(140, 236, 242, 0.19);
+    --t-edge-dim: rgba(0, 0, 0, 0.35);
+    --t-gloss: rgba(255, 255, 255, 0.07);
+    --t-line: rgba(140, 236, 242, 0.1);
+    --t-line-strong: rgba(140, 236, 242, 0.2);
+    --t-grid: rgba(140, 236, 242, 0.035);
+    --t-ink: #ddf8f7;
+    --t-ink-2: #a8d8da;
+    --t-muted: #7daeb4;
+    --t-faint: #4b7a80;
+    --t-aqua: #3fd2e0;
+    --t-aqua-hi: #8af2f7;
+    --t-aqua-deep: #8af2f7;
+    --t-glow: rgba(63, 210, 224, 0.5);
+    --t-lime: #b6f24e;
+    --t-danger: #ff7a5c;
+    --t-lift: 0 24px 40px -22px rgba(0, 0, 0, 0.8);
+    --t-inset: inset 0 1px 3px rgba(0, 0, 0, 0.5);
+    --t-world: url('/kiroku/bg-night.jpg');
+    --t-world-o: 0.8;
+    --t-bloom: rgba(63, 210, 224, 0.22);
+    --t-disc-shadow: rgba(0, 0, 0, 0.6);
+    --ran-color-bg: #061416;
+    --ran-color-bg-elevated: #0d262a;
+    --ran-color-bg-muted: #0d262a;
+    --ran-color-bg-hover: #143438;
+    --ran-color-bg-active: #1b4a50;
+    --ran-color-primary: #ddf8f7;
+    --ran-color-primary-text: #061416;
+  }
+}
+
+/* ---------- the world: blurred photo + bloom + lime leak + faint 28px grid ---------- */
+.kiroku-desktop body {
+  position: relative;
+  isolation: isolate;
+  min-height: 100vh;
+  background: var(--t-bg);
+  color: var(--t-ink);
+  font-family: var(--t-font);
+  font-weight: 500;
+  -webkit-font-smoothing: antialiased;
+}
+.kiroku-desktop body::before {
+  content: '';
+  position: fixed;
+  inset: -30px;
+  z-index: -2;
+  pointer-events: none;
+  background: var(--t-world) center / cover no-repeat;
+  opacity: var(--t-world-o);
+  filter: saturate(1.3);
+}
+.kiroku-desktop body::after {
+  content: '';
+  position: fixed;
+  inset: 0;
+  z-index: -1;
+  pointer-events: none;
+  background:
+    radial-gradient(55% 45% at 92% -5%, var(--t-bloom), transparent 70%),
+    radial-gradient(40% 50% at -5% 105%, color-mix(in srgb, var(--t-lime) 20%, transparent), transparent 70%),
+    linear-gradient(var(--t-grid) 1px, transparent 1px) 0 0 / 28px 28px,
+    linear-gradient(90deg, var(--t-grid) 1px, transparent 1px) 0 0 / 28px 28px;
+}
+.kiroku-desktop ::selection {
+  background: color-mix(in srgb, var(--t-aqua) 30%, transparent);
+  color: var(--t-ink);
+}
+.kiroku-desktop ::-webkit-scrollbar {
+  width: 10px;
+  height: 10px;
+}
+.kiroku-desktop ::-webkit-scrollbar-thumb {
+  background: var(--t-line-strong);
+  border: 3px solid transparent;
+  background-clip: padding-box;
+  border-radius: 8px;
+}
+
+/* ---------- bar: only the wordmark survives (no GitHub, language menu or theme switch) ---------- */
+.kiroku-desktop header.bar {
+  border-bottom: 0;
+  padding-top: 22px;
+  padding-bottom: 0;
+}
+.kiroku-desktop header.bar nav {
+  display: none;
+}
+.kiroku-desktop header.bar .brand {
+  pointer-events: none;
+  color: var(--t-ink);
+}
+.kiroku-desktop header.bar .wordmark {
+  font: 300 24px/1 var(--t-logo);
+  letter-spacing: -0.02em;
+  color: var(--t-ink);
+}
+
+/* ---------- glass panels: 1px white edge, gradient glass, backdrop blur, radius 22 ---------- */
+.kiroku-desktop :is(.history-header, .history-list, .history-rail, .history-empty) {
+  border: 1px solid var(--t-edge);
+  border-radius: 22px;
+  background: linear-gradient(180deg, var(--t-glass-2), var(--t-glass));
+  box-shadow:
+    inset 0 1px 0 var(--t-gloss),
+    inset 0 -1px 0 var(--t-edge-dim),
+    var(--t-lift);
+  -webkit-backdrop-filter: blur(20px) saturate(1.5);
+  backdrop-filter: blur(20px) saturate(1.5);
+}
+.kiroku-desktop .history-header {
+  padding: 26px 30px 28px;
+  gap: 12px;
+}
+.kiroku-desktop .history-list {
+  padding: 8px;
+  border-top: 1px solid var(--t-edge);
+}
+.kiroku-desktop .history-rail {
+  padding: 22px;
+  gap: 18px;
+}
+.kiroku-desktop .history-page {
+  gap: 20px;
+}
+
+/* ---------- header: frosted status capsule, (title) in aqua parentheses, labels in wide caps ---------- */
+.kiroku-desktop .history-chip {
+  padding: 7px 14px 7px 12px;
+  gap: 10px;
+  border: 1px solid var(--t-edge);
+  background: linear-gradient(180deg, var(--t-glass-hi), var(--t-glass-2));
+  box-shadow:
+    inset 0 1px 0 var(--t-gloss),
+    0 6px 14px -8px var(--t-glow);
+  -webkit-backdrop-filter: blur(14px);
+  backdrop-filter: blur(14px);
+  font: 400 7.5px/1.4 var(--t-wide);
+  letter-spacing: 0.3em;
+  text-transform: uppercase;
+  color: var(--t-ink-2);
+}
+/* no status dots anywhere: the chip and the "not exported" labels read on their own */
+.kiroku-desktop .history-chip-dot,
+.kiroku-desktop .history-dot {
+  display: none;
+}
+.kiroku-desktop .history-title {
+  font: 300 40px/1.1 var(--t-logo);
+  letter-spacing: -0.025em;
+  color: var(--t-ink);
+}
+.kiroku-desktop .history-title::before,
+.kiroku-desktop .history-title::after {
+  color: var(--t-aqua);
+  font-weight: 300;
+}
+.kiroku-desktop .history-title::before {
+  content: '(';
