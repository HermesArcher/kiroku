diff --git a/styles/base.css b/styles/base.css
index 74a5517..dd0c9ed 100644
--- a/styles/base.css
+++ b/styles/base.css
@@ -1,3 +1,4 @@
+@import './kiroku-fonts.css';
 @import './assistant.css';
 
 /* No CSS framework here: every design VALUE comes from the ranui token layer
@@ -146,6 +147,111 @@ body.landing-active #app {
   font-size: var(--ran-text-heading-2);
 }
 
+/* Kiroku: "Aqua-Gen" loading screen. Day #DCEFEE + white bloom, night #061416 + cyan bloom;
+   a small spinning photoreal CD (/kiroku/ui/disc.png, same image as the shell), an aqua->lime hairline shimmer
+   and a wide letter-spaced caps label. Fonts: /kiroku/fonts via kiroku-fonts.css. */
+.loading-mask-kiroku {
+  --tl-bg: #dcefee;
+  --tl-ink: #0f3a46;
+  --tl-muted: #44707b;
+  --tl-bloom: rgba(255, 255, 255, 0.85);
+  --tl-cast: rgba(34, 175, 196, 0.18);
+  --tl-aqua: #6ee3ee;
+  --tl-lime: #b9e53a;
+  --tl-track: rgba(15, 58, 70, 0.1);
+  --tl-shadow: rgba(16, 92, 104, 0.35);
+  background:
+    radial-gradient(60% 50% at 90% -8%, var(--tl-bloom), transparent 70%),
+    radial-gradient(55% 60% at -5% 105%, var(--tl-cast), transparent 70%), var(--tl-bg);
+  backdrop-filter: none;
+}
+@media (prefers-color-scheme: dark) {
+  :root:not([data-ran-theme='light']) .loading-mask-kiroku {
+    --tl-bg: #061416;
+    --tl-ink: #ddf8f7;
+    --tl-muted: #7daeb4;
+    --tl-bloom: rgba(63, 210, 224, 0.22);
+    --tl-cast: rgba(63, 210, 224, 0.07);
+    --tl-aqua: #8af2f7;
+    --tl-lime: #b6f24e;
+    --tl-track: rgba(140, 236, 242, 0.1);
+    --tl-shadow: rgba(0, 0, 0, 0.6);
+  }
+}
+:root[data-ran-theme='dark'] .loading-mask-kiroku {
+  --tl-bg: #061416;
+  --tl-ink: #ddf8f7;
+  --tl-muted: #7daeb4;
+  --tl-bloom: rgba(63, 210, 224, 0.22);
+  --tl-cast: rgba(63, 210, 224, 0.07);
+  --tl-aqua: #8af2f7;
+  --tl-lime: #b6f24e;
+  --tl-track: rgba(140, 236, 242, 0.1);
+  --tl-shadow: rgba(0, 0, 0, 0.6);
+}
+.kiroku-loading {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 22px;
+}
+.kiroku-loading-disc {
+  width: 64px;
+  height: 64px;
+  background: url('/kiroku/ui/disc.png') center / contain no-repeat;
+  filter: drop-shadow(0 8px 12px var(--tl-shadow));
+  animation: kiroku-loading-spin 3.5s linear infinite;
+}
+@keyframes kiroku-loading-spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+.kiroku-loading-line {
+  position: relative;
+  width: 168px;
+  height: 1.5px;
+  overflow: hidden;
+  border-radius: 2px;
+  background: var(--tl-track);
+}
+.kiroku-loading-line::after {
+  content: '';
+  position: absolute;
+  inset: 0 auto 0 0;
+  width: 46%;
+  background: linear-gradient(90deg, transparent, var(--tl-aqua) 30%, var(--tl-lime) 70%, transparent);
+  animation: kiroku-loading-run 1.8s cubic-bezier(0.22, 0.61, 0.36, 1) infinite;
+}
+@keyframes kiroku-loading-run {
+  from {
+    transform: translateX(-100%);
+  }
+  to {
+    transform: translateX(220%);
+  }
+}
+.kiroku-loading-label {
+  margin-right: -0.34em; /* optical: cancel the trailing letter-spacing */
+  font:
+    400 9px/1.4 'Lexend Zetta',
+    'Segoe UI',
+    sans-serif;
+  letter-spacing: 0.34em;
+  text-transform: uppercase;
